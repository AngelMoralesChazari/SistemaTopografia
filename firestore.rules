rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function hasRole(role) {
      return signedIn() && (
        ('role' in request.auth.token && request.auth.token.role == role)
        || userDoc().role == role
      );
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('super_admin');
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isLabManager() {
      return hasRole('lab_manager') || isAdmin();
    }

    function isTeacher() {
      return hasRole('teacher') || isLabManager();
    }

    function sameLab(data) {
      return ('labId' in request.auth.token && data.labId == request.auth.token.labId)
        || data.labId == userDoc().labId;
    }

    function isApprovedRenter() {
      return hasRole('renter')
        && userDoc().renterStatus == 'approved'
        && userDoc().active == true;
    }

    // Perfiles
    match /users/{userId} {
      allow read: if signedIn() && (
        uid() == userId ||
        isLabManager() ||
        (resource.data.role == 'teacher' && sameLab(resource.data)) ||
        (hasRole('teacher') && sameLab(resource.data))
      );

      // Particular crea su propio perfil, Alumno crea su perfil institucional, o Administrador da de alta
      allow create: if (signedIn()
        && uid() == userId
        && request.resource.data.role == 'renter'
        && request.resource.data.renterStatus == 'pending'
        && request.resource.data.active == false
        && request.resource.data.keys().hasAll([
          'email', 'displayName', 'role', 'labId', 'active', 'renterStatus',
          'phone', 'company', 'ine', 'rfc', 'address'
        ])) || (
          signedIn()
          && uid() == userId
          && request.resource.data.role == 'student'
          && request.resource.data.active == true
          && ('labId' in request.resource.data)
          && request.resource.data.email.matches('.*@uagro[.]mx$')
        ) || (
          isAdmin()
          && sameLab(request.resource.data)
        );

      // Administradores y encargados actualizan usuarios de su laboratorio, o el alumno actualiza su propio perfil
      allow update: if (isLabManager() && sameLab(resource.data)) || (
        signedIn()
        && uid() == userId
        && resource.data.role == 'student'
        && request.resource.data.role == 'student'
        && request.resource.data.labId == resource.data.labId
      );

      allow delete: if false;
    }

    // Catálogo
    match /equipment/{equipmentId} {
      allow read: if signedIn();
      allow create, update: if isLabManager()
        && request.resource.data.labId == userDoc().labId
        && request.resource.data.keys().hasAll([
          'internalCode', 'name', 'status', 'qtyTotal', 'qtyAvailable', 'labId', 'active'
        ]);
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow create, update: if isLabManager()
        && request.resource.data.labId == userDoc().labId;
      allow delete: if false;
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && sameLab(request.resource.data);
    }

    // Préstamos
    match /loans/{loanId} {
      allow read: if signedIn() && (
        isLabManager() ||
        resource.data.studentId == uid() ||
        resource.data.teacherId == uid()
      );

      allow create: if signedIn()
        && request.resource.data.studentId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.labId == userDoc().labId
        && request.resource.data.keys().hasAll([
          'folio', 'labId', 'status', 'equipmentId', 'studentId', 'teacherId'
        ])
        && (
          (
            hasRole('student')
            && request.resource.data.loanType != 'rental'
          )
          || (
            hasRole('teacher')
            && request.resource.data.teacherId == uid()
            && request.resource.data.loanType != 'rental'
          )
          || (
            isApprovedRenter()
            && request.resource.data.loanType == 'rental'
            && request.resource.data.teacherId == 'lab-rental'
          )
        );

      allow update: if isLabManager()
        && resource.data.labId == userDoc().labId;

      allow delete: if false;

      match /events/{eventId} {
        allow read: if signedIn() && (
          isLabManager() ||
          get(/databases/$(database)/documents/loans/$(loanId)).data.studentId == uid() ||
          get(/databases/$(database)/documents/loans/$(loanId)).data.teacherId == uid()
        );
        allow write: if false;
      }
    }

    match /payments/{paymentId} {
      allow read: if isLabManager();
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == uid();
      allow write: if false;
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /stats/{docId} {
      allow read: if isLabManager();
      allow write: if false;
    }

    match /auditLogs/{logId} {
      // Solo el superadministrador ve la bitácora de admins
      allow read: if isSuperAdmin()
        && resource.data.labId == userDoc().labId;
      allow create: if isAdmin()
        && request.resource.data.actorId == uid()
        && request.resource.data.labId == userDoc().labId
        && request.resource.data.keys().hasAll([
          'labId', 'actorId', 'actorEmail', 'actorName', 'actorRole',
          'action', 'targetType', 'targetId', 'summary'
        ]);
      allow update, delete: if false;
    }
  }
}
